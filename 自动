//																			
// 返り値	:	
//																			
// 機能説明	:	自動請求確定フラグ更新
//																			
//***************************************************************************
void	RCatfxSeiqkSQL::UpdateAutokakuteiFlagON()
{
	string strsql = "";

	strsql.append(" UPDATE " );
	strsql.append("  RE" + prt_strTenKbn + "HUSER" + prt_strKenCD + "." );
	strsql.append("R" + prt_strTenKbn + "Seiqk" );
	strsql.append("  SET AUTOKAKUTEIFLAG = '1' " );
	strsql.append("  WHERE " );
	strsql.append("   STATUS IN ('00', '10', '11')" );

	memset(szSQL, '\0', sizeof(szSQL));
	memcpy(szSQL, (char*)strsql.c_str(), strsql.length());

	EXEC SQL WHENEVER SQLERROR CONTINUE;
	EXEC SQL WHENEVER SQLWARNING CONTINUE;
	EXEC SQL WHENEVER NOT FOUND CONTINUE;

	EXEC SQL PREPARE sql_stmt FROM :szSQL;
	EXEC SQL EXECUTE sql_stmt;

	if (0 != sqlca.sqlcode && 1403 != sqlca.sqlcode){
		// UPDATE失敗
		CREcomnDB::pvtSetErrInfo();
		throw new RCatfxLogger(REKMSG_E009, "RCatfxSeiqkSQL::UpdateAutokakuteiFlagON " + getSqlErrMsg(sqlca.sqlcode) + " ", RECOMN_ERR_DB, __LINE__);
	}
}

//***************************************************************************
// 機能		:	AutoKakuteiCount
//																			
// 返り値	:	
//																			
// 機能説明	:	自動請求確定対象のレコード数を取得
//																			
//***************************************************************************
int		RCatfxSeiqkSQL::AutoKakuteiCount()
{
	EXEC SQL BEGIN DECLARE SECTION;
		int		idbRecCount = 0;					// レコード数
	EXEC SQL END DECLARE SECTION;

	EXEC SQL WHENEVER SQLERROR CONTINUE;
	EXEC SQL WHENEVER SQLWARNING CONTINUE;
	EXEC SQL WHENEVER NOT FOUND CONTINUE;

	string strsql = "";

	strsql.append(" SELECT " );
	strsql.append("     COUNT(HCODE) " );
	strsql.append(" FROM " );
	strsql.append("  RE" + prt_strTenKbn + "HUSER" + prt_strKenCD + "." );
	strsql.append("R" + prt_strTenKbn + "Seiqk" );
	strsql.append("  WHERE " );
	strsql.append("   AUTOKAKUTEIFLAG = '1'" );
	strsql.append("   AND STATUS IN ('00', '10', '11')" );

	memset(szSQL, '\0', sizeof(szSQL));
	memcpy(szSQL, (char*)strsql.c_str(), strsql.length());

	EXEC SQL PREPARE sql_stmt FROM :szSQL;
	EXEC SQL DECLARE autokakuteicount_cursor CURSOR FOR sql_stmt;

	EXEC SQL WHENEVER SQLERROR CONTINUE;
	EXEC SQL WHENEVER SQLWARNING CONTINUE;

	// カーソルオープン
	EXEC SQL
			OPEN autokakuteicount_cursor;

	if (0 != sqlca.sqlcode){
		// OPEN失敗
		CREcomnDB::pvtSetErrInfo();
		throw new RCatfxLogger(REKMSG_E005, "RCatfxSeiqkSQL::AutoKakuteiCount Open " + getSqlErrMsg(sqlca.sqlcode) + " ", RECOMN_ERR_DB, __LINE__);
	}

	EXEC SQL WHENEVER SQLERROR CONTINUE;
	EXEC SQL WHENEVER NOTFOUND CONTINUE;
	EXEC SQL WHENEVER SQLWARNING CONTINUE;

	// カーソルフェッチ
	EXEC SQL
		FETCH autokakuteicount_cursor INTO
			 :idbRecCount
	;

	if (0 != sqlca.sqlcode){
		// FETCH失敗
		CREcomnDB::pvtSetErrInfo();
		throw new RCatfxLogger(REKMSG_E007, "RCatfxSeiqkSQL::AutoKakuteiCount Select " + getSqlErrMsg(sqlca.sqlcode) + " ", RECOMN_ERR_DB, __LINE__);
	}

	// カーソルクローズ
	EXEC SQL
			Close autokakuteicount_cursor;

	if (0 != sqlca.sqlcode){
		// CLOSE失敗
		CREcomnDB::pvtSetErrInfo();
		CREcomnLog::s_pszErrFuncName = (char*)string("RCatfxSeiqkSQL::AutoKakuteiCount Close " + getSqlErrMsg(sqlca.sqlcode)).c_str();
		CREcomnLog::LogOut("          ", "RCatfx", RECOMN_C004);
	}

	return idbRecCount;
}


//***************************************************************************
// 機能		:	OpenSeiqk
//																			
// 返り値	:	
//																			
// 機能説明	:	請求管理カーソルオープン
//																			
//***************************************************************************
void	RCatfxSeiqkSQL::OpenSeiqk()
{
	EXEC SQL WHENEVER SQLERROR CONTINUE;
	EXEC SQL WHENEVER SQLWARNING CONTINUE;

	string strsql = "";

	strsql.append(" SELECT " );
	strsql.append("   Hcode " );
	strsql.append("  ,Sosinkai " );
	strsql.append("  ,Svrname " );
	strsql.append("  ,Aspflg " );
	strsql.append("  ,Jdaikocode " );
	strsql.append("  ,Upduserid " );
	strsql.append(" FROM " );
	strsql.append("  RE" + prt_strTenKbn + "HUSER" + prt_strKenCD + "." );
	strsql.append("R" + prt_strTenKbn + "Seiqk" );
	strsql.append("  WHERE " );
	strsql.append("   STATUS = '11'" );
	strsql.append("   AND AUTOKAKUTEIFLAG = '1'" );
	strsql.append("  ORDER BY SOSINCDATE" );

	memset(szSQL, '\0', sizeof(szSQL));
	memcpy(szSQL, (char*)strsql.c_str(), strsql.length());

	// SQL構文解析
	EXEC SQL PREPARE stmt_seiqk FROM :szSQL;

	// カーソル宣言
	EXEC SQL DECLARE seiqk_cursor CURSOR FOR stmt_seiqk;

	EXEC SQL WHENEVER SQLERROR CONTINUE;
	EXEC SQL WHENEVER SQLWARNING CONTINUE;

	// カーソルオープン
	EXEC SQL OPEN seiqk_cursor;

	if (0 != sqlca.sqlcode){
		// OPEN失敗
		CREcomnDB::pvtSetErrInfo();
		throw new RCatfxLogger(REKMSG_E005, "RCatfxSeiqkSQL::OpenSeiqk " + getSqlErrMsg(sqlca.sqlcode) + " ", RECOMN_ERR_DB, __LINE__);
	}
}

//***************************************************************************
// 機能		:	SelectSeiqk
//																			
// 返り値	:	
//																			
// 機能説明	:	請求管理レコードを検索する
//																			
//***************************************************************************
void	RCatfxSeiqkSQL::SelectSeiqk()
{
	this->ClearOut();

	EXEC SQL WHENEVER SQLERROR CONTINUE;
	EXEC SQL WHENEVER NOTFOUND CONTINUE;
	EXEC SQL WHENEVER SQLWARNING CONTINUE;

	// フェッチ
	EXEC SQL FETCH seiqk_cursor INTO
			 :szdbOutHcode:sHcode
			,:idbOutSosinkai:sSosinkai
			,:szdbOutSvrname:sSvrname
			,:szdbOutAspflg:sAspflg
			,:szdbOutJdaikocode:sJdaikocode
			,:szdbOutUpduserid:sUpduserid
	;

	if (0 != sqlca.sqlcode && iSQLCODE_NOTFOUND != sqlca.sqlcode){
		// フェッチ失敗の場合
		CREcomnDB::pvtSetErrInfo();
		//   REKMSG_E007 : カーソルフェッチエラー
		throw new RCatfxLogger(REKMSG_E007, "RCatfxSeiqkSQL::SelectSeiqk " + RCatfxSeiqkSQL::getSqlErrMsg(sqlca.sqlcode) + " ", RECOMN_ERR_DB, __LINE__);
	}

	if (0 > sJdaikocode){
		memset(szdbOutJdaikocode, '\0', sizeof(szdbOutJdaikocode));
	}

	RCatfxSeiqkDataOut->set_Hcode(string(szdbOutHcode));
	RCatfxSeiqkDataOut->set_Sosinkai(idbOutSosinkai);
	RCatfxSeiqkDataOut->set_Svrname(string(szdbOutSvrname));
	RCatfxSeiqkDataOut->set_Aspflg(string(szdbOutAspflg));
	RCatfxSeiqkDataOut->set_Jdaikocode(string(szdbOutJdaikocode));
	RCatfxSeiqkDataOut->set_Upduserid(string(szdbOutUpduserid));
}

