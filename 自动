//***************************************************************************
const	string	RCatfxSeiqkSQL::getSqlErrMsg(int iRet)
{
	
	string strSqlErrMsg = "";

	stringstream strSqlErrCode;
	string strSqlErrDetail = "";

	if (RECOMN_SUCCESS != iRet){

		strSqlErrCode << "[SQLコード] " << CREcomnInfo::s_lDBCode;
		strSqlErrDetail = string(CREcomnInfo::s_pszDBMsg);
		strSqlErrMsg = strSqlErrCode.str() + " [SQLメッセージ] " + strSqlErrDetail;
	}

	return strSqlErrMsg;
}
