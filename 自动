//***************************************************************************
// 機能		:	UpdateSeiqk
//																			
// 返り値	:	
//																			
// 機能説明	:	請求管理テーブルステータス更新
//																			
//***************************************************************************
void	RCatfxSeiqkSQL::UpdateSeiqk()
{
	this->ClearIn();

	memcpy(szdbInStatus, (char*)RCatfxSeiqkDataIn->get_Status().c_str(), sizeof(szdbInStatus) - 1);
	memcpy(szdbInSeiqkakuteikbn, (char*)RCatfxSeiqkDataIn->get_Seiqkakuteikbn().c_str(), sizeof(szdbInSeiqkakuteikbn) - 1);
	memcpy(szdbInUpduserid, (char*)RCatfxSeiqkDataIn->get_Upduserid().c_str(), sizeof(szdbInUpduserid) - 1);
	memcpy(szdbInHcode, (char*)RCatfxSeiqkDataIn->get_Hcode().c_str(), sizeof(szdbInHcode) - 1);
	idbInSosinkai = atoi((char*)RCatfxSeiqkDataIn->get_Sosinkai().c_str());

	string strsql = "";

	strsql.append(" UPDATE " );
	strsql.append("  RE" + prt_strTenKbn + "HUSER" + prt_strKenCD + "." );
	strsql.append("R" + prt_strTenKbn + "Seiqk" );
	strsql.append("  SET STATUS = :szdbInStatus " );
	strsql.append("     ,SEIQKAKUTEIKBN = :szdbInSeiqkakuteikbn " );
	strsql.append("     ,SEIQKAKUTEIDATE = TO_DATE(TO_CHAR(SYSDATE,'YYYYMM') || '" + prt_strAtfxDay + "235959', 'YYYYMMDDHH24MISS') " );
	strsql.append("     ,UPDUSERID = DECODE( " );
	strsql.append("          INSTR(UPDUSERID,'SeiSien'), " );
	strsql.append("          1,UPDUSERID, " );
	strsql.append("          :szdbInUpduserid " );
	strsql.append("       ) " );
	strsql.append("  WHERE " );
	strsql.append("   HCODE =:szdbInHcode" );
	strsql.append("   AND SOSINKAI = :idbInSosinkai" );

	memset(szSQL, '\0', sizeof(szSQL));
	memcpy(szSQL, (char*)strsql.c_str(), strsql.length());

	EXEC SQL WHENEVER SQLERROR CONTINUE;
	EXEC SQL WHENEVER SQLWARNING CONTINUE;
	EXEC SQL WHENEVER NOT FOUND CONTINUE;

	EXEC SQL PREPARE sql_stmt FROM :szSQL;
	EXEC SQL EXECUTE sql_stmt using 
							 :szdbInStatus
							,:szdbInSeiqkakuteikbn
							,:szdbInUpduserid
							,:szdbInHcode
							,:idbInSosinkai
	;

	if (0 != sqlca.sqlcode){
		// UPDATE失敗
		CREcomnDB::pvtSetErrInfo();
		throw new RCatfxLogger(REKMSG_E009, "RCatfxSeiqkSQL::UpdateSeiqk " + getSqlErrMsg(sqlca.sqlcode) + " ", RECOMN_ERR_DB, __LINE__);
	}
	
}

