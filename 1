<?xml version="1.0" encoding="Windows-31J"?>
<project name="医再審請求ファイル作成ツール" default="package" basedir=".">

	<!-- インストーラ (Mac/Linux) 版アーカイブ内基準ディレクトリ名 -->
	<property name="prefix" value="OnlineSetup_Iryou_Linux" />

	<!-- ソースツリーのビルド -->
	<target name="compile">
	</target>

	<!-- インストーラの jar 作成 -->
	<target name="OnlineSetup_Iryou_Linux" depends="compile">
		<mkdir dir="dist" />
	</target>

	<!-- 各インストーラ用パッケージ作成 -->
	<target name="package" depends="OnlineSetup_Iryou_Linux">

		<!-- Linux -->
		<delete file="dist/OnlineSetup_Iryou_Linux.tar.gz" />
		<tar destfile="dist/OnlineSetup_Iryou_Linux.tar.gz" longfile="gnu" compression="gzip">
			<tarfileset dir="${prefix}" mode="0755" includes="**" prefix="${prefix}">
				<include name="**" />
			</tarfileset>
		</tar>

	</target>

</project>
